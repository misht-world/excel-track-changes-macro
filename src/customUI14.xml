<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="TC_RibbonLoad">
  <ribbon>
    <tabs>
      <tab id="tcTab" getLabel="TC_GetLabel" insertAfterMso="TabView">
        <group id="tcGroupTrack" getLabel="TC_GetLabel">
          <button id="tcStart" size="large" imageMso="ReviewTrackChanges"
                  getLabel="TC_GetLabel" getScreentip="TC_GetScreentip" onAction="TC_OnAction"/>
          <button id="tcAcceptAll" size="large" imageMso="ReviewAcceptChange"
                  getLabel="TC_GetLabel" getScreentip="TC_GetScreentip" onAction="TC_OnAction"/>
          <box id="tcBoxSmall" boxStyle="vertical">
            <button id="tcAcceptSel" imageMso="ReviewAcceptChange"
                    getLabel="TC_GetLabel" getScreentip="TC_GetScreentip" onAction="TC_OnAction"/>
            <button id="tcRefresh" imageMso="Refresh"
                    getLabel="TC_GetLabel" getScreentip="TC_GetScreentip" onAction="TC_OnAction"/>
            <button id="tcStop" imageMso="ReviewRejectChange"
                    getLabel="TC_GetLabel" getScreentip="TC_GetScreentip" onAction="TC_OnAction"/>
          </box>
        </group>
        <group id="tcGroupStyle" getLabel="TC_GetLabel">
          <dropDown id="tcStyle" sizeString="Text and fill WW"
                    getLabel="TC_GetLabel" getScreentip="TC_GetScreentip"
                    getItemCount="TC_GetItemCount" getItemLabel="TC_GetItemLabel"
                    getSelectedItemIndex="TC_GetSelectedItemIndex" onAction="TC_OnSelect"/>
          <dropDown id="tcColor" sizeString="Text and fill WW"
                    getLabel="TC_GetLabel" getScreentip="TC_GetScreentip"
                    getItemCount="TC_GetItemCount" getItemLabel="TC_GetItemLabel"
                    getSelectedItemIndex="TC_GetSelectedItemIndex" onAction="TC_OnSelect"/>
        </group>
        <group id="tcGroupHelp" getLabel="TC_GetLabel">
          <button id="tcHelp" size="large" imageMso="Help"
                  getLabel="TC_GetLabel" getScreentip="TC_GetScreentip" onAction="TC_OnAction"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
